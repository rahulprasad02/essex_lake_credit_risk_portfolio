# Choose provider: 'langchain_openai' or 'openai' (default) or 'offline'
LLM_PROVIDER=langchain_openai

# Configuration for LangChain ChatOpenAI
LANGCHAIN_OPENAI_API_KEY=your_api_key_here
LANGCHAIN_OPENAI_BASE_URL=https://your-custom-endpoint.com/v1
LANGCHAIN_OPENAI_MODEL_NAME=gpt-4.1

# Configuration for direct OpenAI fallback
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o-mini